# --- Storage ---------------------------------------------------------------
# On Fly/Railway point this at a mounted volume so the ledger survives deploys.
MONEYBOT_DB=/data/moneybot.db
MONEYBOT_MEDIA_DIR=/data/media

# --- Who is allowed to talk to it -----------------------------------------
# Comma-separated. His phone in E.164, and/or his Telegram chat id.
# Leave empty and the FIRST person to text the bot is remembered as the owner.
MONEYBOT_ALLOWED_SENDERS=+18165550147

# --- The split (percent of every payment, as decimals) --------------------
MONEYBOT_RESERVE_PCT=0.37
MONEYBOT_SAVINGS_PCT=0.15
MONEYBOT_SWING_PCT=0.10
# spending is whatever is left over

# --- Multi-state sourcing -------------------------------------------------
MONEYBOT_HOME_STATE=MO

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
MONEYBOT_MODEL=claude-opus-5

# --- Twilio (SMS) ---------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+18165550100
MONEYBOT_VALIDATE_SIGNATURE=1

# --- Telegram (optional second channel; free photos) ----------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Public URL, used for signature checks and CSV links ------------------
MONEYBOT_BASE_URL=https://moneybot.example.com

# --- Cron ------------------------------------------------------------------
MONEYBOT_CRON_TOKEN=generate-a-long-random-string
MONEYBOT_NAG_CHANNEL=sms
